# Copy to .env.staging at the repository root. Never commit that file.
PRODUCTION_SUPABASE_PROJECT_REF=replace_with_production_ref
STAGING_SUPABASE_PROJECT_REF=replace_with_staging_ref
STAGING_SUPABASE_URL=https://replace_with_staging_ref.supabase.co
STAGING_SUPABASE_PUBLISHABLE_KEY=replace_with_staging_publishable_key
# Only needed for seeding; NEVER add this to Vercel or the frontend.
STAGING_SUPABASE_SECRET_KEY=replace_locally_with_staging_secret_key
CONFIRM_STAGING_REF=replace_with_staging_ref
