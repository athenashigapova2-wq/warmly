{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "analytics": false
  },
  "projects": {
    "warmly": {
      "projectType": "application",
      "root": "Client",
      "sourceRoot": "Client/src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "Client/src/main.ts",
            "index": "Client/src/index.html",
            "tsConfig": "Client/tsconfig.app.json",
            "styles": [
              "Client/src/styles.css"
            ],
            "outputPath": "dist/warmly",
            "assets": [
              {
                "glob": "**/*",
                "input": "Client/public",
                "output": "/"
              }
            ]
          },
          "configurations": {
            "production": {
              "optimization": {
                "scripts": true,
                "styles": true,
                "fonts": false
              },
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "650kB",
                  "maximumError": "1MB"
                }
              ]
            },
            "development": {
              "optimization": false,
              "sourceMap": true,
              "outputHashing": "none"
            },
            "qa": {
              "browser": "tests/ui-main.ts",
              "tsConfig": "tests/tsconfig.ui.json",
              "optimization": false,
              "outputHashing": "none"
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "warmly:build:development",
            "proxyConfig": "Client/proxy.json"
          }
        }
      }
    }
  }
}
