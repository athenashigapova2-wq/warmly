{
  "name": "warmly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "start": "npm run build && node --env-file-if-exists=.env Server/index.js",
    "dev": "concurrently -k \"node --env-file-if-exists=.env --watch Server/index.js\" \"ng serve --host 127.0.0.1\"",
    "build": "ng build && node Hosting/build.mjs",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs",
    "preview:hosted": "node --env-file-if-exists=.env Hosting/preview.mjs"
  },
  "dependencies": {
    "@angular/common": "21.2.26",
    "@angular/compiler": "21.2.26",
    "@angular/core": "21.2.26",
    "@angular/forms": "21.2.26",
    "@angular/platform-browser": "21.2.26",
    "express": "^5.1.0",
    "rxjs": "^7.8.2",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.0.0",
    "@angular/cli": "21.0.0",
    "@angular/compiler-cli": "21.2.26",
    "concurrently": "^9.2.1",
    "playwright": "1.56.1",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "@babel/helper-string-parser": "7.27.1",
    "@babel/helper-validator-identifier": "7.27.1",
    "rollup": "4.52.4"
  }
}
